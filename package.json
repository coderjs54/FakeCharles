{
  "name": "fake-charles",
  "version": "1.0.0",
  "description": "FakeCharles - a Charles-like HTTP/HTTPS debugging proxy desktop app",
  "main": "./out/main/index.js",
  "author": "FakeCharles",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && electron-vite build",
    "selftest": "electron-vite build && electron . --selftest",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:dir": "pnpm build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "sass-embedded": "^1.108.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "node-forge": "^1.4.3"
  }
}
